# Copy to .env and change the passwords. .env is git-ignored.
POSTGRES_USER=chronicle
POSTGRES_PASSWORD=change-me
POSTGRES_DB=connectome

# Host ports (non-default to avoid clashing with other local databases)
COORDINATOR_PORT=55432
SHARD1_PORT=55433
SHARD2_PORT=55434
SHARD3_PORT=55435
MONGO_PORT=57017

MONGO_USER=chronicle
MONGO_PASSWORD=change-me
MONGO_DB=connectome_meta

# Optional token for mapping reviews, ranking jobs and shard deployment jobs.
# Leave empty for a localhost-only classroom demo. Set before sharing the API.
CC_REVIEW_TOKEN=
